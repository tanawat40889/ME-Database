# Telegram (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_SESSION=
VAULT_TITLE_PREFIX=TBackup

# Features
FAVORITE_EMOJI=❤️
DESCRIPTION_WINDOW_MIN=0
RESCAN_CRON=0 4 * * *
MAX_CONCURRENT_DOWNLOADS=4
DATA_DIR=./data

# Web / Auth
PORT=8080
# paste the whole line printed by `npm run hash-password`, keeping its single quotes (docker compose expands $ otherwise)
APP_PASSWORD_HASH=
SESSION_SECRET=
SESSION_VERSION=1

# HTTP
COOKIE_SECURE=1             # 0 only for plain-http local testing
TRUST_PROXY=0               # 1 when behind Cloudflare Tunnel / reverse proxy (real client IP for rate limits)
WEB_DIR=../web/dist
